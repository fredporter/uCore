# uCore Environment Variables
# Copy this to .env and fill in your values

# GitHub Integration
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Continue.dev / MCP
MCP_SERVER_PORT=8765

# Database
DB_PATH=./ucore.db

# Logging
LOG_LEVEL=INFO

# Local Developer chat and NanoCoder construction model (native tool calling).
UCORE_DEVELOPER_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
